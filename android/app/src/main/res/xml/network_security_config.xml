<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Voyager's own HTTP clients admit cleartext only to user-configured
         loopback/private-LAN music servers. Roadstr providers, maps, search,
         Wikipedia and other built-in endpoints remain HTTPS-only in code. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
