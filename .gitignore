# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local SDK paths — machine-specific, never portable between checkouts.
android/local.properties
**/local.properties

# Signing credentials — never commit.
android/key.properties
*.jks
*.keystore

# Anything that looks like a secret, even though nothing in this repo
# currently needs one — defensive, so a future addition can't slip in by
# forgetting to update this file first.
.env
.env.*
*.env
secrets.*
google-services.json
GoogleService-Info.plist

# The patched Roadstr mirror and everything copied out of it, all produced by
# tools/prepare_roadstr.sh. Generated, never edited by hand; re-run the script
# after pulling Roadstr.
.roadstr/
assets/icons/
assets/cursors/
assets/kokoro_phrases/
assets/espeak-ng-data.tar.gz
android/app/src/main/jniLibs/
