+  Widget _voyagerRouteChip(RoadstrColors c, int index) {
+    final route = widget.alternatives[index];
+    final selected = index == widget.selected;
+    return Padding(
+      padding: const EdgeInsets.only(right: 8),
+      child: GestureDetector(
+        onTap: () => widget.onSelect(index),
+        child: Container(
+          // Tall enough to be a target, not a label.
+          constraints: const BoxConstraints(minHeight: 56, minWidth: 92),
+          padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 8),
+          decoration: BoxDecoration(
+            color: selected
+                ? c.accent.withValues(alpha: 0.18)
+                : Colors.transparent,
+            borderRadius: BorderRadius.circular(14),
+            border: Border.all(color: selected ? c.accent : c.border),
+          ),
+          child: Column(
+            mainAxisAlignment: MainAxisAlignment.center,
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              Text(route.durationLabel,
+                  style: TextStyle(
+                      color: c.textPrimary,
+                      fontSize: 17,
+                      fontWeight: FontWeight.w700)),
+              Text(route.distanceLabel,
+                  style: TextStyle(color: c.textSecondary, fontSize: 13)),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
