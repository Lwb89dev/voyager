+                          autocorrect: false,
+                          onChanged: (_) => setDlg(() {}),
+                          style: TextStyle(color: c.textPrimary, fontSize: 14),
+                          decoration: InputDecoration(
+                            hintText: l.exportPasswordHint,
+                            hintStyle: TextStyle(color: c.textSecondary),
+                            filled: true,
+                            fillColor: c.surface1,
+                            border: OutlineInputBorder(
+                                borderRadius: BorderRadius.circular(12),
+                                borderSide: BorderSide.none),
+                            contentPadding: const EdgeInsets.symmetric(
+                                horizontal: 14, vertical: 12),
+                          ),
+                        ),
+                      ],
+                    ]),
+                actions: [
+                  TextButton(
+                      onPressed: () => Navigator.pop(ctx, false),
+                      child: Text(l.cancel,
+                          style: TextStyle(color: c.textSecondary))),
+                  FilledButton(
+                    style: FilledButton.styleFrom(backgroundColor: c.accent),
+                    onPressed: (!encryptIt || ctrl.text.isNotEmpty)
+                        ? () => Navigator.pop(ctx, true)
+                        : null,
+                    child: Text(l.exportButton,
+                        style: const TextStyle(color: Colors.white)),
+                  ),
+                ],
+              )),
+    );
+    if (go != true || !mounted) return;
+
+    final plaintext =
+        jsonEncode(_store.favorites.map((f) => f.toMap()).toList());
+    final Map<String, dynamic> envelope;
+    if (encryptIt && ctrl.text.isNotEmpty) {
+      envelope = {
+        'v': 1,
+        'encrypted': true,
+        ...await FavoritesCrypto.encryptAsync(plaintext, ctrl.text)
+      };
+    } else {
+      envelope = {'v': 1, 'encrypted': false, 'data': plaintext};
+    }
+    try {
+      final bytes = Uint8List.fromList(utf8.encode(jsonEncode(envelope)));
+      final path = await FilePicker.saveFile(
+        fileName: 'roadstr_favorites.json',
+        type: FileType.custom,
+        allowedExtensions: ['json'],
+        bytes: bytes,
+      );
+      if (!mounted) return;
+      if (path != null) _snack(l.exportSuccessSnack);
+    } catch (_) {
+      if (mounted) _snack(l.exportFailedSnack);
+    }
