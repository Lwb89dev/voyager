+  Future<String?> _promptPassword(String title) {
+    final ctrl = TextEditingController();
+    final c = widget.colors;
+    return showDialog<String>(
+      context: context,
+      builder: (ctx) => AlertDialog(
+        backgroundColor: c.surface2,
+        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(20)),
+        title:
+            Text(title, style: TextStyle(color: c.textPrimary, fontSize: 15)),
+        content: TextField(
+          controller: ctrl,
+          obscureText: true,
+          autocorrect: false,
+          autofocus: true,
+          style: TextStyle(color: c.textPrimary, fontSize: 14),
+          decoration: InputDecoration(
+            filled: true,
+            fillColor: c.surface1,
+            border: OutlineInputBorder(
+                borderRadius: BorderRadius.circular(12),
+                borderSide: BorderSide.none),
+            contentPadding:
+                const EdgeInsets.symmetric(horizontal: 14, vertical: 12),
+          ),
+          onSubmitted: (v) => Navigator.pop(ctx, v),
+        ),
+        actions: [
+          TextButton(
+              onPressed: () => Navigator.pop(ctx, null),
+              child: Text(AppLocalizations.of(ctx).cancel,
+                  style: TextStyle(color: c.textSecondary))),
+          FilledButton(
+            style: FilledButton.styleFrom(backgroundColor: c.accent),
+            onPressed: () => Navigator.pop(ctx, ctrl.text),
+            child: Text(AppLocalizations.of(ctx).ok,
+                style: const TextStyle(color: Colors.white)),
+          ),
+        ],
+      ),
+    );
+  }
+
+  Future<void> _pushSync() async {
+    final l = AppLocalizations.of(context);
+    if (_store.nostrPub == null || _store.syncBusy) return;
+    setState(() => _store.syncBusy = true);
+    final ok = await _store.syncSvc.push(
+        favorites: _store.favorites,
+        pubKeyHex: _store.nostrPub!,
+        privKeyHex: _store.nostrPriv,
+        passphrase: _store.syncPassphrase);
+    if (!mounted) return;
+    setState(() => _store.syncBusy = false);
+    if (ok) {
+      _store._box
+          .put('favoritesSyncLastAt', DateTime.now().millisecondsSinceEpoch);
+    }
+    _snack(ok ? l.syncSuccessSnack : l.syncFailedSnack);
+  }
+
+  Future<void> _pullSync() async {
+    final l = AppLocalizations.of(context);
+    if (_store.nostrPub == null || _store.syncBusy) return;
+    setState(() => _store.syncBusy = true);
+    var result = await _store.syncSvc.pull(
+        pubKeyHex: _store.nostrPub!,
+        privKeyHex: _store.nostrPriv,
+        passphrase: _store.syncPassphrase);
+    if (!mounted) return;
+    if (result.needsPassphrase) {
+      final entered = await _promptPassword(l.importPasswordPrompt);
+      if (!mounted) return;
+      if (entered != null && entered.isNotEmpty) {
+        result = await _store.syncSvc.pull(
+            pubKeyHex: _store.nostrPub!,
+            privKeyHex: _store.nostrPriv,
+            passphrase: entered);
+        if (!mounted) return;
+        if (result.favorites != null) {
+          await _FavoritesStore._st
+              .write(key: 'favorites_sync_passphrase', value: entered);
+          _store.syncPassphrase = entered;
+        }
+      }
+    }
+    setState(() => _store.syncBusy = false);
+    final fetched = result.favorites;
+    if (fetched == null) {
+      _snack(l.syncFailedSnack);
+      return;
+    }
+    for (final f in fetched) {
+      final dup = _store.favorites.indexWhere((e) => e.label == f.label);
+      if (dup >= 0) {
+        _store.favorites[dup] = f;
+      } else {
+        _store.favorites.add(f);
+      }
+    }
+    _store.saveFavorites();
+    _store._box
+        .put('favoritesSyncLastAt', DateTime.now().millisecondsSinceEpoch);
+    _snack(l.syncSuccessSnack);
+  }
