+            children: [
+              Text(l.syncPassphraseDesc,
+                  style: TextStyle(
+                      color: c.textSecondary, fontSize: 12.5, height: 1.5)),
+              const SizedBox(height: 12),
+              TextField(
+                controller: ctrl,
+                obscureText: true,
+                autocorrect: false,
+                autofocus: true,
+                style: TextStyle(color: c.textPrimary, fontSize: 14),
+                decoration: InputDecoration(
+                  hintText: l.exportPasswordHint,
+                  hintStyle: TextStyle(color: c.textSecondary),
+                  filled: true,
+                  fillColor: c.surface1,
+                  border: OutlineInputBorder(
+                      borderRadius: BorderRadius.circular(12),
+                      borderSide: BorderSide.none),
+                  contentPadding:
+                      const EdgeInsets.symmetric(horizontal: 14, vertical: 12),
+                ),
+              ),
+            ]),
+        actions: [
+          TextButton(
+              onPressed: () => Navigator.pop(ctx, false),
+              child: Text(l.cancel, style: TextStyle(color: c.textSecondary))),
+          FilledButton(
+            style: FilledButton.styleFrom(backgroundColor: c.accent),
+            onPressed: () => Navigator.pop(ctx, true),
+            child: Text(l.ok, style: const TextStyle(color: Colors.white)),
+          ),
+        ],
+      ),
+    );
+    if (saved != true || !mounted) return;
+    if (ctrl.text.isEmpty) {
+      await _FavoritesStore._st.delete(key: 'favorites_sync_passphrase');
+      _store.syncPassphrase = null;
+    } else {
+      await _FavoritesStore._st
+          .write(key: 'favorites_sync_passphrase', value: ctrl.text);
+      _store.syncPassphrase = ctrl.text;
+    }
+    if (!mounted) return;
+    setState(() {});
+  }
