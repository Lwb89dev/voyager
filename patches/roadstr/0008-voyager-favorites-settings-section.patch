+class FavoritesSyncSection extends StatefulWidget {
+  final RoadstrColors colors;
+  const FavoritesSyncSection({super.key, required this.colors});
+
+  @override
+  State<FavoritesSyncSection> createState() => _FavoritesSyncSectionState();
+}
