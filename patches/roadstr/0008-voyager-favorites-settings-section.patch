+// VOYAGER: a self-contained extraction of the favourites + Nostr sync
+// section from Roadstr's own settings_screen.dart, so a host embedding
+// Roadstr (Voyager) can offer it from its own settings screen without
+// duplicating ~500 lines of tightly-coupled dialog and sync logic by hand.
+//
+// Deliberately independent of _SettingsScreenState: it loads its own
+// favourites list and Nostr identity in initState rather than reading them
+// off an enclosing screen, so it can be dropped into any parent. Roadstr's
+// own settings screen keeps its original inline copy — extracting that one
+// too, so both call through here, is a larger and riskier change to an
+// already very large file than this patch is trying to be.
+import 'dart:async';
+import 'dart:convert';
+import 'dart:isolate';
+import 'dart:typed_data';
+
+import 'package:file_picker/file_picker.dart';
