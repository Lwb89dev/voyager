+/// Favourites: the list, add/edit, export/import, and Nostr sync (NIP-44,
+/// kind 30078) — everything under Roadstr's "Favourites" and "Sync" section
+/// headers, as two widgets so a host can place its own section header
+/// between them exactly as Roadstr's own settings screen does.
+class FavoritesListSection extends StatefulWidget {
+  final RoadstrColors colors;
+  const FavoritesListSection({super.key, required this.colors});
+
+  @override
+  State<FavoritesListSection> createState() => FavoritesListSectionState();
+}
