+  Future<void> _importFavorites() async {
+    final l = AppLocalizations.of(context);
+    try {
+      final file = await FilePicker.pickFile(
+          type: FileType.custom, allowedExtensions: ['json']);
+      if (file == null) return;
+      if (file.size > _FavoritesStore._maxImportBytes) {
+        throw const FormatException('Favorites import is too large');
+      }
+      final bytes = await file.readAsBytes();
+      if (bytes.length > _FavoritesStore._maxImportBytes) {
+        throw const FormatException('Favorites import is too large');
+      }
+      final envelope = await Isolate.run(
+          () => jsonDecode(utf8.decode(bytes)) as Map<String, dynamic>);
+      String plaintext;
+      if (envelope['encrypted'] == true) {
+        if (!mounted) return;
+        final password = await _promptPassword(l.importPasswordPrompt);
+        if (password == null || password.isEmpty) return;
+        plaintext = await Isolate.run(
+            () => FavoritesCrypto.decrypt(envelope, password));
+      } else {
+        plaintext = envelope['data'] as String;
+      }
+      final list = await Isolate.run(() => jsonDecode(plaintext) as List);
+      final imported = list
+          .whereType<Map>()
+          .map((m) => FavoritePlace.fromMapSafe(m))
+          .whereType<FavoritePlace>()
+          .take(FavoritePlace.maxStoredItems)
+          .toList();
+      if (!mounted) return;
+      for (final f in imported) {
+        final dup = _store.favorites.indexWhere((e) => e.label == f.label);
+        if (dup >= 0) {
+          _store.favorites[dup] = f;
+        } else {
+          _store.favorites.add(f);
+        }
+      }
+      _store.saveFavorites();
+      _snack(l.importSuccessSnack(imported.length));
+    } catch (_) {
+      if (mounted) _snack(l.importFailedSnack);
+    }
+  }
